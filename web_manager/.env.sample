# =============================================================================
# web_manager/.env.sample -> copy thanh web_manager/.env
# =============================================================================

# Application
APP_PORT=3000
APP_HOST=127.0.0.1

# Environment
NODE_ENV=development
NODE_HTTPS=server_edu

# Database
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=hust_tech
DB_PORT=3306
# MongoDB used by /api/mongodb.  Never expose this URI to clients.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=iot
# MONGODB_REPORT_TIMEZONE=Asia/Ho_Chi_Minh
APP_LINK_STORGATE=http://localhost:3000
# Mysql socket path /path/to/mysql.sock
#SOCKET_PATH=<YOUR_SOCKET_PATH>

# Log
LOG_DIR=logs
#LOG_LEVEL='debug'

TOKEN_SECRET_KEY=<RANDOM_SECRET>

ASSETSDIR='public'

ID_S3_INFO=
SECRET_S3_INFO=
BUCKET_NAME_S3_INFO=
FILE_S3_RETURN=
LINK_FLODER_PUBLIC=

# GMAIL INFO
MAIL_CLIENT_INFO=
MAIL_PASS_INFO=
KEY_ZALO_TOCKEN=
KEY_ZALO_ID=

#FacebookInfo
FACE_BOOK_ACAO=
FACE_BOOK_PASSS=

# -----------------------------------------------------------------------------
# MQTT client (trang /mqtt). MqttBroker1885.js chi nhan MQTTS + mTLS ECDSA P-256.
# -----------------------------------------------------------------------------
MQTT_PROTOCOL=mqtts
# Host/IP cua server broker (phai co trong subjectAltName cua server.crt)
MQTT_HOST=localhost
MQTT_PORT=1885
MQTT_USER=
MQTT_PASS=
# clientId phai trung CN chung chi va fingerprint trong mqtt_device_certs.json
MQTT_CLIENT_ID=web_manager
MQTT_KEEPALIVE=60
# Thu muc chung chi tren server web_manager: ca.crt,
# <MQTT_CLIENT_ID>.crt, <MQTT_CLIENT_ID>.key
MQTT_CERTS=../mqttBroker/certs
# Tuy chon: duong dan rieng thay cho MQTT_CERTS
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# false khi broker tat enableAttack (chong replay)
MQTT_REPLAY_PROTECTION=true
# Khi broker bat enableMessageAuthentication: key trong mqtt_message_auth.json
MQTT_HMAC_SECRET=
MQTT_HMAC_KEY_ID=web_manager

# -----------------------------------------------------------------------------
# MQTT broker provisioning (saveCertificateMqtt / getCertificateMqtt /
# revokeCertificateMqtt). Chay "npx knex migrate:latest" truoc khi dung.
#
#  * Broker o SERVER KHAC: dat MQTT_BROKER_ADMIN_URL -> goi
#    mqttBroker/BrokerAdminApi.js qua HTTPS + mTLS, dung MQTT_CA_CERT /
#    MQTT_CLIENT_CERT / MQTT_CLIENT_KEY (chung chi web_manager) o tren.
#  * Broker CUNG SERVER: de trong MQTT_BROKER_ADMIN_URL -> ghi thang cac file
#    JSON trong MQTT_BROKER_DIR.
# -----------------------------------------------------------------------------
# Vi du: https://10.0.0.5:8885
MQTT_BROKER_ADMIN_URL=
# Ten host co trong subjectAltName cua chung chi BrokerAdminApi, khi URL dung
# IP/ten khac (vi du URL la IP noi bo nhung SAN chi co IP public)
MQTT_BROKER_ADMIN_SERVERNAME=
MQTT_BROKER_ADMIN_TIMEOUT_MS=5000
# Chu ky gui lai cau hinh / lenh thu hoi broker chua nhan (ms, 0 = tat)
MQTT_BROKER_SYNC_INTERVAL_MS=30000
# Thu muc CA (ca.crt + ca.key) va chung chi/khoa thiet bi tren server
# web_manager. Mac dinh = MQTT_CERTS. Thiet bi bi thu hoi duoc chuyen vao
# <MQTT_PKI_DIR>/revoked/.
MQTT_PKI_DIR=
# Chi dung khi MQTT_BROKER_ADMIN_URL trong. Mac dinh = thu muc cha cua MQTT_PKI_DIR
MQTT_BROKER_DIR=

# Web Push (thong bao nen) - nut Bat lang nghe nen tren trang /mqtt
# Neu khong khai VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY server tu sinh va luu tai server/config/vapid.keys.json
VAPID_SUBJECT=mailto:admin@localhost
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
