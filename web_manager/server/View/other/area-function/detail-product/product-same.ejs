<div class="col-lg-3 col-xs-0 co best-seller-group m-auto text-center" style="margin-top: 0px !important">
    <div class="best-seller-item" id="ids_ads_home">
    </div>
</div>

<script type="text/javascript"> 
          function getDataInfoAdvertisement(data){
                  var infoData = "";
                  for(var i=0;(i<1);i++){
                      getInfoHtml(data[i].filesave,
                                  (info)=>
                                  {
                                    if(info==false) return; 
                                      infoData = infoData + '<div style="margin-top: 30px;">' +info + '</div>';
                                      $("#ids_ads_home").html(infoData);
                                  });
                  }
          }

          
         getInfoHtml("/api/customers/info_ads", (data) => {
            if(data==false) return; 
            getDataInfoAdvertisement(data.result); 
        });
</script>