<script type="text/javascript">
    
    var dataView = '<%= info %>';
    
    async  function uploadImageData(event){
            const data = new FormData() 
            data.append('file', event.files[0]);
            try {
              let response = await fetch('/api/customers/import-image-customer', 
                {method: "POST", body: data}); 
              const result = await response.json();
              $("#image_user_avatar").attr("src",result.url );
            } 
            catch(e) 
            {
            }   
    }
    var infoDataSave = null;
    getInfoData('/api/auth/info_customer',{},(dataJson)=>{
               //getShopOnline(dataJson.result);
        if(dataJson!=false){
          
              $("#image_user_1").attr("src", dataJson.user.avatar);
              $("#image_user_2").attr("src",  dataJson.user.avatar);
              $("#image_user_avatar").attr("src",  dataJson.user.avatar); 
              $("#name_user_1").html(dataJson.user.email);
              $("#input-first-name").val(dataJson.user.fullname);
              $("#input-email").val(dataJson.user.email);
              $("#input-username").val( dataJson.user.username);
              $("#input-address").val(dataJson.user.address);
              $("#input-phone-number").val(dataJson.user.phone);
              if(dataJson.user.permission_id==0)
                  $("#permission_check").html(`<a href="/register-new-company"><h3> Đăng ký doanh nghiệp </h3> </a>`);
              else
                  $("#permission_check").html(`<a href="http://localhost:3030/customer/#/"><h3> Màn hình quản lý </h3> </a>`);

              infoDataSave = dataJson.user;
              
        }
    });

    function saveInfoData(){
        if(infoDataSave==null){
          // $("#image_user_avatar").attr("src",result.url );
          return;
        }
        infoDataSave.fullname =$("#input-first-name").val();
        infoDataSave.avatar =$("#image_user_avatar").attr('src');
        infoDataSave.username =$("#input-username").val();
        infoDataSave.address =$("#input-address").val();
        infoDataSave.phone =$("#input-phone-number").val();
        infoDataSave.isUpdatePassWord= false;
        postInfoData('/api/customers/save_user_info',infoDataSave,(dataJson)=>{
            if(!dataJson.error){
              Swal.fire( "Sửa thông tin","<i>Đã sửa thông tin thành công!</i>", "<u>Đồng ý</u>");
            }
        });
    }

    function changePassWord(){
      Swal.fire({
          title: 'Xin vui lòng nhập thông tin mật khẩu',
          html:`
            <input id="swal-input1" class="swal2-input" type="password" placeholder="Mật khẩu" /> 
            <input id="swal-input2" class="swal2-input" type="password" placeholder="Mật khẩu mới" />
            <input id="swal-input3" class="swal2-input" type="password" placeholder="Nhập lại mật khẩu" />`,
          allowOutsideClick: false,
          showCloseButton: true,
          preConfirm: function () {
            return new Promise(function (resolve) {
              resolve([
                $('#swal-input1').val(),
                $('#swal-input2').val(),
                $('#swal-input3').val()
              ])
            })
          },
          onOpen: function () {
            $('#swal-input1').focus()
          }
        }).then(function (result) {
          if(!result.isConfirmed) return;
          if(result.value[1].length<8) {
            Swal.fire( "Sửa thông tin","Độ dài mật khẩu quá ngắn xin vui lòng nhập > 8 ký tự", "<u>Đồng ý</u>");
            return;
          }
          if(result.value[0]==result.value[1]){
            Swal.fire( "Sửa thông tin","Mật khẩu cũ và mới đang giống nhau, xin vui lòng kiểm tra lại", "<u>Đồng ý</u>");
            return;
          }
          if(result.value[1]!=result.value[2]){
            Swal.fire( "Sửa thông tin","Mật khẩu mới không trùng khớp xin vui lòng nhập lại", "<u>Đồng ý</u>");
            return;
          }
         
          postInfoData('/api/customers/save_user_info',{customer_id:infoDataSave.customer_id, old:result.value[0],password:result.value[1],isUpdatePassWord:true},(dataJson)=>{
                  if(!dataJson.error){
                    Swal.fire( "Sửa thông tin","<i>Đã sửa thông tin thành công!</i>", "<u>Đồng ý</u>");
                  }
          });
        });
    }

   

</script>

