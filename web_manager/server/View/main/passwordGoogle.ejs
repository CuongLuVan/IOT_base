<!DOCTYPE html>

<html lang="en">
  <% include ./layout/header.ejs %>
  <body>
    <% include ./layout/menuSale.ejs %>
    <main>
      <% include ./layout/banner.ejs %>
    
      <!--
        - PRODUCT
      -->

      <div class="product-container">

        <div class="container">

          <div class="product-box">
            <!--
              - PRODUCT GRID
            -->

            <div class="product-main">

              <h2 class="title"> <%= __('productPage') %></h2>

              <div class="product-grid" id="best-seller-items">

                
              </div>
            </div>
          </div>
        </div>
      </div>
      <% include ./layout/layout_pages.ejs %>



      <div class="product-container">
  
          <div class="container">
           <form method="POST" action="/api/auth/set-password">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
                <h3>Tạo mật khẩu</h3>
                <input type="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required />
                <button type="submit">Xác nhận</button>
            </form>
            
          </div>
        </div>
        <% include ./layout/layout_pages_service.ejs %>

    </main>
    <% include ./layout/footer.ejs %>
  </body>
</html>
