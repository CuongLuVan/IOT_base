<!DOCTYPE html>
<html lang="en">
  <% include ./layout/header.ejs %>
  <body>
    <% include ./layout/menuSale.ejs %>
    <main>
        <% include ./layout/banner.ejs %>
        <!--
          - PRODUCT
        -->
  
        <div class="product-container">
  
          <div class="container">
  
            <div class="product-box">
              <!--
                - PRODUCT GRID
              -->
  
              <div class="product-main">
                <h2 class="title"><%= __('productPage') %></h2>
                <div class="product-grid" id="best-seller-items">
                  <div class="showcase">  
                    
  
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    </main>     
    <script type="text/javascript">
        var jsonItemElectric=[];
        var lstGroupElectric={product_group:1,start:-5,end:0};
        loadAnotherElectric();
        function loadAnotherElectric(){
          lstGroupElectric.start+=5;
          lstGroupElectric.end+=5;
          postInfoData('/api/customers/company_lst',lstGroupElectric,(data)=>{
            if(!data.error){
              jsonItemElectric.push(...data.data.result);
              setInfoCompanyToView(jsonItemElectric,"#best-seller-items"); 
            }
          });
        }
    
        function setInfoCompanyToView(items, itemHtml,type="product") {
            var html='';
           //id_created
            items.forEach((element) => {
                var dataInfo = `<div class="showcase">
                  <div class="showcase-banner">
                    <a href="/shop-detail/${(element.company_short)}" >
                    <img src="${element.icon_company}" alt=" ${element.company_short}" class="product-img default"
                      width="300">
                    <img src="${element.icon_company}" alt=" ${element.company_short}" class="product-img hover"
                      width="300">
                    </a>
                    <!--<p class="showcase-badge angle black">...</p> -->
                
                    <div class="showcase-actions">
                      <!--<button class="btn-action">
                        <ion-icon name="heart-outline"></ion-icon>
                      </button>
                
                      <button class="btn-action">
                        <ion-icon name="eye-outline"></ion-icon>
                      </button>
                
                      <button class="btn-action">
                        <ion-icon name="repeat-outline"></ion-icon>
                      </button>
                
                      <button class="btn-action">
                        <ion-icon name="bag-add-outline"></ion-icon>
                      </button> -->
                    </div>
                  </div>
                
                  <div class="showcase-content">
                    <a href="/shop-detail/${(element.company_short)}" class="showcase-category">${element.companyname}</a>
                    <!---
                    <div class="showcase-rating">
                      <ion-icon name="star"></ion-icon>
                      <ion-icon name="star"></ion-icon>
                      <ion-icon name="star"></ion-icon>
                      <ion-icon name="star-outline"></ion-icon>
                      <ion-icon name="star-outline"></ion-icon>
                    </div> --->
                  </div>
                </div>`;
                html+=dataInfo;
            });
            $(itemHtml).html(html);
        }
                
      </script>
    
    <% include ./layout/footer.ejs %>
  </body>
</html>
