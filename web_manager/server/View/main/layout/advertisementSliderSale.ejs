<section id="hero-slider-sale">
  <div
    id="carouselExampleControls"
    class="carousel slide"
    data-ride="carousel"
  >
    <div class="carousel-inner hero-group" id="carouselControls-id-data">
      <div class="carousel-item active hero-item">
        <img
          class="d-block w-100 hero-item-image"
          src="/sale/img/Promotion Image.png"
          alt="First slide"
        />
        <div class="hero-item-text">
          <span>Lam quen voi Airsense</span>
        </div>
      </div>
      <div class="carousel-item">
        <img
          class="d-block w-100 hero-item-image"
          src="/sale/img/Promotion Image.png"
          alt="Second slide"
        />
        <div class="hero-item-text">
          <span>Lam quen voi Airsense</span>
        </div>
      </div>
      <div class="carousel-item">
        <img
          class="d-block w-100 hero-item-image"
          src="/sale/img/Promotion Image.png"
          alt="Third slide"
        />
        <div class="hero-item-text">
          <span>Lam quen voi Airsense</span>
        </div>
      </div>
    </div>
    <a
      class="carousel-control-prev"
      href="#carouselExampleControls"
      role="button"
      data-slide="prev"
    >
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="sr-only">Previous</span>
    </a>
    <a
      class="carousel-control-next"
      href="#carouselExampleControls"
      role="button"
      data-slide="next"
    >
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="sr-only">Next</span>
    </a>
  </div>
  <!----
  <div class="hero-items-sale product-carousel" id="hero-items-slider">
    
  </div> ---->
</section>


<script type="text/javascript">
// 
    var fistElement=0;
    const dataAPIForSliderHeroText = (element) => {
      fistElement++;
      return `<div class="carousel-item ${fistElement==1? "active hero-item":""} ">
              <a href="start-register">
              <img
                class="d-block w-100 hero-item-image"
                src="${element.content_img}"
                alt="First slide"
              />
              <div class="hero-item-text">
                <span>${element.title}</span>
              </div></a>
            </div>`;
    };

    const dataAPIForEachProduct = (element) => {
      var text="";
      if(element.cost_real!=element.cost_detail)  text=`<del>${element.cost_real}</del>`;
      let dataInfor =
        `<div
          class="hero-item-sale grid"
          style="
            background-image: url('${element.image_info_detail }');
            background-size: cover;
            background-position: center;
          "
        > <a href="/product/product_detail?type=${element.product_id}">
          <span class="hero-item-sale-name">` +
        element.name_image_detail +
        `</span>
          <span class="hero-item-sale-percent"
            >${text}<span class="text-discount">${element.promotion}</span></span
          >
          <span class="hero-item-sale-price">${setValueCost(element.cost_detail,"VND") }</span>
            </a>
        </div>`;
      return dataInfor;
    };
    
    getInfoHtml("/api/customers/info_ads", (data) => {
        if(data==false) return; 
        fistElement=0;
        dataHtml = loadAllHtmlToShow(data.result, dataAPIForSliderHeroText);
        $("#carouselControls-id-data").html(dataHtml);
    });

   /* postInfoData('/api/customers/new-product-check',{product_group:[1,2,3]},(data)=>{
      setNewProduct(data.result, "#hero-items-slider", dataAPIForEachProduct, 3);
    });*/
</script>
