<style>

        

        .desktop-menu-category-group-product { 
            position: relative;
            display: flex;
            justify-content: left;
            align-items: center;
            gap: 5px;
        }
        .desktop-menu-category-group-product> .menu-title {
            position: relative;
            color:hsl(290deg 62% 73%);
            font-size: var(--fs-7);
            font-weight: var(--weight-600);
            text-transform: uppercase;
            padding: 4px 10px 4px 10px;
            transition: var(--transition-timing);
            border-style: solid;
            border-color: black;
            border-width: 1px;
            padding: 4px 10px 4px 10px;
            border-radius: 5px;
            background-color: rgb(255, 255, 255);
        }

        .desktop-menu-category-group-product> .menu-title-selected {
            position: relative;
            color:hsl(290deg 62% 73%);
            font-size: var(--fs-7);
            font-weight: var(--weight-600);
            text-transform: uppercase;
            padding: 4px 10px 4px 10px;
            transition: var(--transition-timing);
            border-style: solid;
            border-color: black;
            border-width: 1px;
            padding: 4px 10px 4px 10px;
            border-radius: 5px;
            background-color: aqua;
        }

        .desktop-menu-category-group-product.menu-title:hover { color: var(--salmon-pink); }

        .drop-mobile-btn {
            background-color: #4CAF50;
            color: white;
            padding: 6px;
            font-size: 16px;
            margin-bottom: 10px;
            border: none;
            cursor: pointer;
        }

        .drop-mobile-down {
            position: relative;
            display: inline-block;
        }

        .drop-mobile-down-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 300px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 9;
        }

        .drop-mobile-down-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }

        .drop-mobile-down-content a:hover {background-color: #f1f1f1}

        .drop-mobile-down:hover .drop-mobile-down-content {
            display: block;
        }

        .drop-mobile-down:hover .drop-mobile-btn {
            background-color: #3e8e41;
        }

        @media only screen and (max-width: 600px) {
            .desktop-menu-category-group-product{
                display: none;
            }
        }
        @media only screen and (min-width: 600px) {
            .drop-mobile-down{
                display: none;
            }
        }


</style>

<div class="product-container">
    <div class="container">
        <div id="meunu-sale-deatail-pc" class="desktop-menu-category-group-product">
            <a href="#" class="menu-title"> Tất cả </a>
        </div>
        <div class="drop-mobile-down">
            <button class="drop-mobile-btn" >Danh mục</button>
            <div class="drop-mobile-down-content" id="meunu-sale-deatail-mobile">
              
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    const searchParamsMenu = (new URL(document.location)).searchParams;
    var typeInfo = searchParamsMenu.get("type");
    var linkAdd = ((window.location.href).split('?'))[0];
    if(typeInfo==undefined||typeInfo==null) typeInfo = '<%= detail %>';
   
    postInfoData('/api/customers/lst_group_info',{id_group:typeInfo},(data)=> {                          
        if(!data.error){
            let typeItem= searchParamsMenu.get("item");
            let dataInfo = data.data.result;//.push(...data.data.result);
            let html = `<a href="${linkAdd}" class="${typeItem?"menu-title":"menu-title-selected"}"> Tất cả </a>`;
            for(var x=0;x<dataInfo.length;x++){
                html = html + `<a href="${linkAdd}?item=${dataInfo[x].product_group_id}" class="${typeItem!=dataInfo[x].product_group_id?"menu-title":"menu-title-selected"}">${dataInfo[x].product_group_content} </a>`;
            }
            $("#meunu-sale-deatail-pc").html(html);
            $("#meunu-sale-deatail-mobile").html(html);
           
        }
    });  

</script>


