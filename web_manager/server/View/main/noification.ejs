             document.getElementById('root_comment').style.display = "block";
             document.getElementById('click-review').style.borderBottom = '2px solid #33a0ff';
             document.getElementById('click-descrip').style.border = 'none';
           }
           function setItemByDatePage(item) {
               item.sort((el1, el2) => {
                   element1 = el1.updated_at.toUpperCase();
                   element2 = el2.updated_at.toUpperCase();
                   if (element1 > element2) return -1;
                   else return 1;
               });
               return item;
           }

