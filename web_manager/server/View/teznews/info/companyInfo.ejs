<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content=" chợ xanh bốn mùa , sản phẩm chất lượng cho cuộc sống ">
    <meta name="author" content="congnd91">
    <title>Tri thức chợ xanh bốn mùa</title>
    <!-- Favicons -->
    <link rel="shortcut icon" href="/teznews/images/favicon.png">
    <link rel="apple-touch-icon" href="/teznews/images/apple-touch-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/teznews/images/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/teznews/images/apple-touch-icon-114x114.png">
    <!-- Online Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Oswald:300,400,700&subset=latin-ext" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:100,300,400,700" rel="stylesheet">
    <!-- Vender -->
    <link href="/teznews/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/teznews/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/teznews/css/normalize.min.css" rel="stylesheet" />
    <link href="/teznews/css/owl.carousel.min.css" rel="stylesheet" />
    <!-- Main CSS (SCSS Compile) -->
    <link href="/teznews/css/main.css" rel="stylesheet" />
    <script src="/teznews/js/jquery.min.js"></script>
    <script src="/teznews/js/bootstrap.js"></script>
    <script src="/teznews/js/owl.carousel.min.js"></script>
    <script src="/teznews/js/main.js"></script>
    <script src="/js/commonJS.js"></script>
    <!-- JavaScripts -->
    <!--<script src="js/modernizr.js"></script>-->
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body>
    <div class="page">
        <div class="box-caption">
            <span>Nổi bật</span>
        </div>
        <!--sportlight-->
        <section class="owl-carousel owl-spotlight" id="owl_spotlight_id" >
            
        </section>
        <section class="spotlight-thumbs">
            <div class="row" id="spotlight_thumbs_id">
                
            </div>
        </section>
        
        <script type="text/javascript">
                function infoValueDataThree(item){
                    var html="";
                    for(var i=0;((i< 4)&&(i<item.length));i++){
                        var linkInfo=getInfoLink(item[i]);
                        html = html +
                                `<div>
                                    <article class="spotlight-item">
                                        <div class="spotlight-img ">
                                            <img alt="chợ xanh 4 mùa" src="`+item[i].content_img+`" class="img-responsive" />
                                            <a href="`+linkInfo+`" class="cate-tag">`+item[i].title+`</a>
                                        </div>
        
                                        <div class="spotlight-item-caption">
                                            <h2 class="font-heading"> <a href="`+linkInfo+`">`+item[i].title+`</a></h2>
                                            <div class="meta-post">
                                                <a href="`+linkInfo+`">
                                                    ##
                                                </a>
                                                <em></em>
                                                <span>
                                                    `+(new Date(item[i].created_at)).toLocaleDateString()+`
                                                </span>
                                            </div>
                                            <p>`+item[i].content+` </p>
                                        </div>
                                    </article>
                                </div>`;
                    }
                    return html;
                }
                function infoSpotLightThumbs(item){
        var html="";
        for(var i=0;((i< 3)&&(i<item.length));i++){
            var linkInfo=getInfoLink(item[i]);
            var contentSub=getDetailContent(item[i].group_content_sub_id);
            html=  html+ 
                    `<div class="col-md-4 col-sm-4 col-xs-12">
                        <div class="spotlight-item-thumb">
                            <div class="spotlight-item-thumb-img">
                                <div class="info-head-thump-crop">
                                    <a href="`+linkInfo+`">
                                        <img alt="chợ xanh 4 mùa" src="`+item[i].content_img+`" />
                                    </a>
                                </div>
                                <a href="`+linkInfo+`" class="cate-tag">`+contentSub+`</a>
                            </div>
                            <h3><a href="`+linkInfo+`">`+item[i].title+`</a></h3>
                            <div class="meta-post">
                                <a href="`+linkInfo+`">`+contentSub+`
                                    
                                </a>
                                <em></em>
                                <span>
                                    `+(new Date(item[i].created_at)).toLocaleDateString()+`
                                </span>
                            </div>
                        </div>
                    </div>`;
            
        }
        return html;
    }

    getInfoDataPublic('/api/document/get_home',(dataJson)=>{
        if(dataJson!=false)
        {
            $("#owl_spotlight_id").html(infoValueDataThree(dataJson));
            $('.owl-spotlight').data('owlCarousel').destroy();
            $('.owl-spotlight').owlCarousel({
                loop: true,
                nav: true,
                items: 1,
                mouseDrag: false,
                navText: ["<i class='fa fa-angle-left'></i>", "<i class='fa fa-angle-right'></i>"]
            });
            $("#spotlight_thumbs_id").html(infoSpotLightThumbs(dataJson));
        }
        
    });
                
        </script>
        

    </div>
</body>
</html>

