<script type="text/javascript">
    var dataView = '<%= detail %>';
    var linkAcess = "";
    var linkAcessDetail = '/api/document/group_page';
    var onselectIndex = 0;
    function getContentHtml(linkData){
      getInfoHtml(linkData,(data)=>{
            if(data==false) return; 
            $('#htmlToView').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
            $('html, body').animate({ scrollTop: 0 }, 'fast');
      });
    }

    var dataViewLstLink=[];
    function infoGroupPagesToShow(item){
        var html="";
       
        for(var i=0;i<item.length;i++){
            var linkInfo=getInfoLink(item[i]);
            
            if(i==onselectIndex){
                //loadDataPage(i);
                html=  html+    `
                                <h4 style="color: blueviolet;" onclick="loadDataPage(`+i+`)"><a>`+item[i].title+`</a></h4>
                            `;
            } 
            else
            {
                html=  html+    `
                                <h4 onclick="loadDataPage(`+i+`)"><a>`+item[i].title+`</a></h4>
                            `;
            }
        }
        return html;
    }

    function loadDataPage(int){
        onselectIndex=int;
      let valueData = dataViewLstLink[int];
      getContentHtml("/"+ valueData.filesave);
      var curentHtml = infoGroupPagesToShow(dataViewLstLink);
        $("#tool_description1").html(curentHtml);
    }
    postInfoData(linkAcessDetail,{is_main_pages_id:dataView},(dataJson)=>{
        if(!dataJson.error){
            dataViewLstLink= dataJson.data;
            loadDataPage(0);
        }
        
    });

  </script>

