<script type="text/javascript">
    function getDataInfoAdvertisementHeader(data){
        var htmlToView = '';

        for(var i=0;i<data.length ;i++){
            var linkInfo=getInfoLink(data[i]);
           // <img alt="chợ xanh 4 mùa" src="`+data[i].content_img+`" />
            htmlToView =htmlToView+
                        `<div>
                                <div class="special-news">
                                    <a href="`+linkInfo+`">
                                        <img alt="chợ xanh 4 mùa" src="`+data[i].content_img+`" />
                                    </a>
                                    <h3><a href="`+linkInfo+`">`+data[i].title+`</a></h3>
                                    <div class="meta-post">
                                        <a href="`+linkInfo+`">
                                            `+data[i].content+`
                                        </a>
                                    </div>
                                </div>
                        </div>`;
        }
        $("#head_ads_fist").html(htmlToView);
        if(typeof $('.owl-special').data('owlCarousel') != 'undefined') {
            $('.owl-special').data('owlCarousel').destroy();
            $('.owl-special').removeClass('owl-carousel');
        }
//        $('.owl-special').data('owlCarousel').destroy();
        $('.owl-special').owlCarousel({
            loop: true,
            nav: false,
            dots: false,
            autoplay: true,
            items: 1,
            mouseDrag: false,
        });
     
    }
    postInfoData('/api/document/get_advertisement',{group_content_sub_id:0},(dataJson)=>{
        if(!dataJson.error){
            getDataInfoAdvertisementHeader(dataJson.data);
        }
        
    });
</script>    