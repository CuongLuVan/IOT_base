<section class="box-news tech-home-feed">
    <div class="box-caption">
        <span>Bài viết mới</span>
    </div>
    <div class="tech-home-feed-grid" id="tech_description"></div>
</section>

<script type="text/javascript">
    function infoValueDataAll(itemCurrent) {
        var html = "";
        for (var i = 0; i < itemCurrent.length; i++) {
            var item = itemCurrent[i];
            var linkInfo = getInfoLink(item);
            var contentSub = getDetailContent(item.group_content_sub_id);
            var description = String(item.content || "").replace(/<[^>]*>/g, "");
            if (description.length > 160) description = description.substring(0, 160) + "...";

            html += `<article class="tech-home-feed-card">
                        <a class="tech-home-feed-image" href="` + linkInfo + `">
                            <img alt="" src="` + item.content_img + `" />
                        </a>
                        <div class="tech-home-feed-content">
                            <p class="tech-card-topic">` + contentSub + `</p>
                            <h3><a href="` + linkInfo + `">` + item.title + `</a></h3>
                            <div class="meta-post"><span>` + (new Date(item.created_at)).toLocaleDateString() + `</span></div>
                            <p>` + description + `</p>
                        </div>
                    </article>`;
        }
        return html;
    }

    getInfoDataPublic('/api/document/get_new', (dataJson) => {
        if (dataJson !== false) {
            $("#tech_description").html(infoValueDataAll(dataJson));
        }
    });
</script>
