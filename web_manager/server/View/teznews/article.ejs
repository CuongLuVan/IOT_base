<script type="text/javascript">
    var dataView =  "/"+ '<%= detail %>';
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);
    var linkAcess = urlParams.get('file'); //checkGetQuerryForm(); // + dataView.replaceAll('+', '/');
    if(urlParams.has('file')){
        linkAcess = "/"+linkAcess;
        getInfoHtml(linkAcess,(data)=>{
            if(data==false) return; 
            $('#check_data_side_menu').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
            $('html, body').animate({ scrollTop: 0 }, 'fast');
        });
        
    }
    else
    {
       // linkAcess = dataView;
       var dataView =  '<%= type %>';
       setTimeout(()=>{

            postInfoData('/api/customers/get_page_detail',{data:dataView},(dataJson)=>{
                if(!dataJson.error){
                    if(dataJson.data.result==-1){
                        $('#check_data_side_menu').html(`<h1> The pages not support this langgue </h1>`); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
                        $('html, body').animate({ scrollTop: 0 }, 'fast');
                    }
                    else
                    {
                        getInfoHtml( "/"+ dataJson.data.result,(data)=>{
                            if(data==false) return; 
                            $('#check_data_side_menu').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
                            $('html, body').animate({ scrollTop: 0 }, 'fast');
                        });
                    }
                    
                }
            });
       },1000);
      

    }
   
   // document.getElementById("htmlToView").src = linkAcess;
    

   

 </script>