		<script type="text/javascript">
    var dataView = '<%= detail %>';
    var linkAcess = "";
    var linkAcessDetail = '/api/document/group_page';
    var onselectIndex = 0;
    function getContentHtml(linkData){
      getInfoHtml(linkData,(data)=>{
            if(data==false) return; 
            $('#htmlToView').html(data); //.replaceAll("</p>","<br/>").replaceAll("<p>","<br/>")
            $('html, body').animate({ scrollTop: 0 }, 'fast');
      });
    }

    var dataViewLstLink=[];
    function infoGroupPagesToShow(item){
        var html="";
       
        for(var i=0;i<item.length;i++){
            var linkInfo=getInfoLink(item[i],"/detail/");
            
            if(i==onselectIndex){
                //loadDataPage(i);
                html=  html+    `
                                <div style="color: blueviolet;margin-left: 20px;" onclick="loadDataPage(`+i+`)"><label>`+item[i].title+`</label></div>
                            `;
            } 
            else
            {
                html=  html+    `
                                <div style="color: #406ee4;margin-left: 20px;" onclick="loadDataPage(`+i+`)"><label>`+item[i].title+`</label></div>
                            `;
            }
        }
        return html;
    }

    function loadDataPage(int){
        onselectIndex=int;
		let valueData = dataViewLstLink[int];
		if(valueData.updated_at)
            $('#time_description').html(formatFullDateTimeLocal(valueData.updated_at)); 
        if(valueData.username_updated)
            $('#author_description').html(author_text+ valueData.username_updated); 
		getContentHtml("/"+ valueData.filesave);
		var curentHtml = infoGroupPagesToShow(dataViewLstLink);
			$("#tool_description1").html(curentHtml);
    }
    postInfoData(linkAcessDetail,{is_main_pages_id:dataView},(dataJson)=>{
        if(!dataJson.error){
            dataViewLstLink= dataJson.data;
            loadDataPage(0);
        }
        
    });

  </script>
