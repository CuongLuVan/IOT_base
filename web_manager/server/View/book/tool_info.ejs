                <style>

                    .paging {
                        display: flex;
                        justify-content: center;
                        flex-wrap: wrap;         /* Cho phép xuống dòng khi thiếu chỗ */
                        gap: 4px;                /* Khoảng cách giữa các nút */
                        margin: 20px 0;
                    }

                    .paging a {
                        display: inline-block;
                        padding: 6px 12px;
                        border: 1px solid #ddd;
                        border-radius: 4px;
                        text-decoration: none;
                        color: #007bff;
                        background-color: #fff;
                        font-size: 14px;
                        transition: background-color 0.2s, color 0.2s;
                    }

                    .paging a:hover {
                        background-color: #e9ecef;
                        border-color: #ccc;
                        color: #0056b3;
                    }

                    .paging a.current,
                    .paging a.active {
                        background-color: #007bff;
                        color: white;
                        border-color: #007bff;
                        cursor: default;
                    }

                .side-ad-sp { 
                        
                    margin-top: 0px;
                    padding-right: 70px;
                    padding-left: 70px;
                
                }

                @media (max-width: 1079px) {
                    .side-ad-sp { 
                        
                        margin-top: 22px;
                        padding-right: 0px;
                        padding-left: 0px;
                    
                    }
                }

                   
                </style>
                <div class="paging" id="location_padding_id"></div>
		</section>
