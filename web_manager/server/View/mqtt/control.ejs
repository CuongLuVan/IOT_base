<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MQTT Control Panel</title>
  <style>
    :root{--bg:#0f1923;--card:#16222e;--card2:#101b26;--border:#263746;--text:#dbe7f1;--muted:#8aa2b8;--accent:#00d4aa;--danger:#f54c7a;--warn:#ffb84d;--ok:#2fbf71;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,Arial,sans-serif;min-height:100vh;font-size:14px;}
    .topbar{background:#0b131c;border-bottom:1px solid var(--border);padding:12px 20px;position:sticky;top:0;z-index:100;display:flex;justify-content:space-between;align-items:center;}
    .topbar h1{font-size:19px;font-weight:600;}
    .topbar h1 i{color:var(--accent);margin-right:8px;}
    .layout{max-width:1440px;margin:0 auto;padding:18px;}
    .card{background:var(--card);border:1px solid var(--border);border-radius:10px;margin-bottom:18px;overflow:hidden;}
    .card>.title{background:var(--card2);padding:10px 16px;border-bottom:1px solid var(--border);font-weight:600;font-size:15px;}
    .card>.title i{color:var(--accent);margin-right:8px;}
    .card>.body{padding:16px;}
    .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;}
    .fields .full{grid-column:1 / -1;}
    label{font-size:12.5px;color:var(--muted);display:block;margin-bottom:4px;}
    .input,.select,.textarea{width:100%;background:#0f1923;border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13.5px;padding:7px 10px;font-family:inherit;}
    .input:focus,.select:focus,.textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px rgba(0,212,170,.18);}
    .input::placeholder,.textarea::placeholder{color:#5c7488;}
    .textarea{resize:vertical;min-height:88px;font-family:Consolas,monospace;}
    .btn{display:inline-flex;align-items:center;gap:7px;border:none;border-radius:6px;padding:8px 16px;font-size:13.5px;font-weight:600;cursor:pointer;transition:filter .15s;}
    .btn:disabled{opacity:.6;cursor:not-allowed;}
    .btn:hover{filter:brightness(1.1);}
    .btn-accent{background:var(--accent);color:#06231c;}
    .btn-danger{background:rgba(245,76,122,.14);color:var(--danger);border:1px solid rgba(245,76,122,.45);}
    .btn-ghost{background:transparent;color:var(--text);border:1px solid var(--border);}
    .btn-block{width:100%;justify-content:center;}
    .btn-sm{padding:5px 11px;font-size:12.5px;}
    .badge{display:inline-block;border-radius:20px;padding:6px 14px;font-size:12.5px;font-weight:700;background:#57606a;color:#fff;}
    .badge.ok{background:var(--ok);}
    .badge.warn{background:var(--warn);color:#231a00;}
    .badge.err{background:var(--danger);}
    .status-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-top:14px;}
    .status-item{background:#0f1923;border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
    .status-item .lbl{font-size:11.5px;color:var(--muted);text-transform:uppercase;}
    .status-item .val{font-size:13.5px;font-weight:600;margin-top:2px;word-break:break-all;}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .sub-item{display:flex;justify-content:space-between;align-items:center;background:#0f1923;border:1px solid var(--border);border-radius:6px;padding:6px 10px;margin-top:7px;}
    .sub-item code{font-family:Consolas,monospace;font-size:13px;color:var(--text);}
    .sub-item .btn{padding:3px 10px;font-size:12px;}
    .empty-hint{color:var(--muted);font-size:12.5px;}
    .log-box{background:#0a1118;border:1px solid var(--border);border-radius:8px;height:420px;overflow-y:auto;padding:10px;font-family:Consolas,monospace;font-size:12.5px;}
    .log-item{display:grid;grid-template-columns:76px 1fr 92px;gap:10px;padding:6px 8px;border-bottom:1px solid #16222e;align-items:baseline;}
    .log-item:last-child{border-bottom:none;}
    .log-item .t{color:#5c7488;font-size:11.5px;}
    .log-item .top{color:var(--accent);font-weight:600;word-break:break-all;}
    .log-item .extra{color:var(--muted);font-size:11.5px;text-align:right;white-space:nowrap;}
    .log-item .msg{grid-column:2 / -1;word-break:break-all;white-space:pre-wrap;}
    .log-item.received .msg{color:#7fd8ff;}
    .log-item.publish .msg{color:var(--warn);}
    .log-item.error .msg{color:var(--danger);}
    .switch{display:inline-flex;align-items:center;gap:8px;cursor:pointer;color:var(--text);font-size:13.5px;}
    .switch input{width:17px;height:17px;accent-color:var(--accent);cursor:pointer;}
    .help{font-size:12px;color:var(--muted);line-height:1.5;}
    .help.ok{color:var(--ok);}
    .help.err{color:var(--danger);}
    .row-actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:12px;}
    .row-actions .btn{margin-bottom:0;}
    ::-webkit-scrollbar{width:8px;height:8px;}
    ::-webkit-scrollbar-track{background:#0b131c;}
    ::-webkit-scrollbar-thumb{background:#2a3d50;border-radius:4px;}
    ::-webkit-scrollbar-thumb:hover{background:#3a5269;}
    @media (max-width:900px){.grid-2{grid-template-columns:1fr;}}
  </style>
</head>
<body>
  <header class="topbar">
    <h1><i class="fa">&#xf085;</i>MQTT Control Panel</h1>
    <div style="display:flex;align-items:center;gap:10px;">
      <span id="statusBadge" class="badge">CHƯA KẾT NỐI</span>
      <a class="btn btn-ghost btn-sm" href="/" title="Về trang chủ">&#127968; Home</a>
    </div>
  </header>
  <main class="layout">

    <!-- ===== KẾT NỐI ===== -->
    <section class="card">
      <div class="title">1. Kết nối Broker</div>
      <div class="body">
        <div class="fields">
          <div>
            <label>Protocol</label>
            <select id="protocol" class="select">
              <option value="mqtt" <% if(mqttConfig.protocol==='mqtt'){%>selected<%}%>>mqtt</option>
              <option value="mqtts" <% if(mqttConfig.protocol==='mqtts'){%>selected<%}%>>mqtts</option>
              <option value="ws" <% if(mqttConfig.protocol==='ws'){%>selected<%}%>>ws</option>
              <option value="wss" <% if(mqttConfig.protocol==='wss'){%>selected<%}%>>wss</option>
              <option value="tcp" <% if(mqttConfig.protocol==='tcp'){%>selected<%}%>>tcp</option>
            </select>
          </div>
          <div>
            <label>Host</label>
            <input id="host" class="input" value="<%= mqttConfig.host %>">
          </div>
          <div>
            <label>Port</label>
            <input id="port" class="input" value="<%= mqttConfig.port %>">
          </div>
          <div>
            <label>Username</label>
            <input id="username" class="input" value="<%= mqttConfig.user %>">
          </div>
          <div>
            <label>Password</label>
            <input id="password" type="password" class="input" value="<%= mqttConfig.pass %>">
          </div>
          <div>
            <label>Client ID</label>
            <input id="clientId" class="input" value="<%= mqttConfig.clientId %>">
          </div>
          <div>
            <label>Keepalive (giây)</label>
            <input id="keepalive" class="input" value="<%= mqttConfig.keepalive %>">
          </div>
          <div class="full">
            <label>Topic tự subscribe sau khi connect (phân cách bởi dấu phẩy)</label>
            <input id="autoTopics" class="input" placeholder="vd: sensor/#, notification/+">
          </div>
        </div>
        <div class="row-actions">
          <button id="connectBtn" class="btn btn-accent">&#128268; Connect</button>
          <button id="disconnectBtn" class="btn btn-danger">&#128474; Disconnect</button>
          <button id="importCfgBtn" class="btn btn-ghost" title="Tải lại thông参数 MQTT_* từ server (.env)"><span id="importCfgIcon">&#128190;</span> Import .env</button>
          <span class="help">Cấu hình mặc định lấy từ biến môi trường trong <code>.env</code>.</span>
        </div>
        <div class="status-grid">
          <div class="status-item"><div class="lbl">Trạng thái</div><div class="val" id="statusState">DISCONNECTED</div></div>
          <div class="status-item"><div class="lbl">URL</div><div class="val" id="statusUrl">—</div></div>
          <div class="status-item"><div class="lbl">Client ID</div><div class="val" id="statusClient">—</div></div>
          <div class="status-item"><div class="lbl">Lỗi gần nhất</div><div class="val" id="statusErr">—</div></div>
          <div class="status-item"><div class="lbl">Message đã nhận</div><div class="val" id="statusMsgCount">0</div></div>
        </div>
      </div>
    </section>

    <div class="grid-2">

      <!-- ===== PUBLISH ===== -->
      <section class="card">
        <div class="title">2. Publish</div>
        <div class="body">
          <div class="fields">
            <div class="full">
              <label>Topic</label>
              <input id="pubTopic" class="input" placeholder="vd: iot/device/led1">
            </div>
            <div class="full">
              <label>Message</label>
              <textarea id="pubMessage" class="textarea" placeholder="Nhập nội dung message...">ON</textarea>
            </div>
            <div>
              <label>QoS</label>
              <select id="pubQos" class="select">
                <option value="0">0 - tối đa 1 lần</option>
                <option value="1">1 - ít nhất 1 lần</option>
                <option value="2">2 - chính xác 1 lần</option>
              </select>
            </div>
            <div style="display:flex;align-items:flex-end;">
              <label class="switch"><input type="checkbox" id="pubRetain"> Retain</label>
            </div>
          </div>
          <div class="row-actions" style="margin-top:14px;">
            <button id="publishBtn" class="btn btn-accent btn-block">&#128228; Publish</button>
          </div>
        </div>
      </section>

      <!-- ===== SUBSCRIBE ===== -->
      <section class="card">
        <div class="title">3. Subscribe</div>
        <div class="body">
          <div class="fields">
            <div>
              <label>Topic</label>
              <input id="subTopic" class="input" placeholder="vd: iot/#">
            </div>
            <div>
              <label>QoS</label>
              <select id="subQos" class="select">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
              </select>
            </div>
          </div>
          <div class="row-actions" style="margin-top:14px;">
            <button id="subBtn" class="btn btn-accent btn-block">&#128229; Subscribe</button>
          </div>
          <div style="margin-top:14px;">
            <label>Danh sách đang subscribe</label>
            <div id="subscriptionList" class="empty-hint">— Chưa có topic nào —</div>
          </div>
        </div>
      </section>
    </div>

    <!-- ===== MESSAGE LOG ===== -->
    <section class="card">
      <div class="title" style="display:flex;justify-content:space-between;align-items:center;">
        <span>4. Message nhận được</span>
        <button id="clearLogBtn" class="btn btn-danger btn-sm">&#128465; Xóa log</button>
      </div>
      <div class="body">
        <div id="msgLog" class="log-box"></div>
      </div>
    </section>

    <!-- ===== LẮNG NGHE NỀN ===== -->
    <section class="card">
      <div class="title"><i class="fa">&#128276;</i>5. Lắng nghe nền &amp; thông báo (Background)</div>
      <div class="body">
        <div class="fields">
          <div class="full">
            <label>Lọc topic để nhận thông báo (để trống = tất cả, hỗ trợ ký tự đại diện + vàamp; #)</label>
            <input id="notiffilter" class="input" placeholder="vd: iot/#">
          </div>
        </div>
        <div class="row-actions">
          <button id="bgBtn" class="btn btn-accent">&#128276; Bật lắng nghe nền</button>
          <span id="bgStatus" class="help">Chưa bật. Bật để nhận thông báo hệ thống ngay khi có bản tin MQTT.</span>
        </div>
      </div>
    </section>
  </main>
<script>
    const API = '/api/mqtt';
    let lastMessageId = 0;
    let pushEnabled = false;

    const $ = (id) => document.getElementById(id);

    async function api(path, method, body) {
      const opts = { method: method || 'GET', headers: { 'Content-Type': 'application/json' } };
      if (body !== undefined) opts.body = JSON.stringify(body);
      const res = await fetch(API + path, opts);
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || 'HTTP ' + res.status);
      return json.result;
    }

    function addLog(topic, payload, type, meta) {
      const log = $('msgLog');
      const item = document.createElement('div');
      item.className = 'log-item ' + (type || '');
      const time = document.createElement('span');
      time.className = 't';
      time.textContent = new Date().toLocaleTimeString('vi-VN');
      const top = document.createElement('span');
      top.className = 'top';
      top.textContent = topic;
      const extra = document.createElement('span');
      extra.className = 'extra';
      extra.textContent = meta ? 'qos:' + meta.qos + ' retain:' + (meta.retain ? 'Y' : 'N') : '';
      const msg = document.createElement('span');
      msg.className = 'msg';
      msg.textContent = payload;
      item.appendChild(time);
      item.appendChild(top);
      item.appendChild(extra);
      item.appendChild(msg);
      log.prepend(item);
      while (log.children.length > 200) log.removeChild(log.lastChild);
    }

    function setStatusBadge(status) {
      const b = $('statusBadge');
      let cls = '', txt = 'CHƯA KẾT NỐI';
      if (status.connected) { cls = 'ok'; txt = 'ĐÃ KẾT NỐI'; }
      else if (status.state === 'CONNECTING' || status.state === 'RECONNECTING') { cls = 'warn'; txt = 'ĐANG KẾT NỐI...'; }
      else if (status.state === 'ERROR' || status.state === 'OFFLINE') { cls = 'err'; txt = 'LỖI / MẤT KẾT NỐI'; }
      b.className = 'badge ' + cls;
      b.textContent = txt;
      $('statusState').textContent = status.state || 'DISCONNECTED';
      $('statusUrl').textContent = (status.options && status.options.url) || '—';
      $('statusClient').textContent = (status.options && status.options.clientId) || '—';
      $('statusErr').textContent = status.lastError || '—';
      $('statusMsgCount').textContent = status.messageCount || 0;
    }

    async function refreshStatus() {
      try {
        const st = await api('/status');
        setStatusBadge(st);
        const list = $('subscriptionList');
        list.innerHTML = '';
        if (!st.subscriptions || !st.subscriptions.length) {
          list.innerHTML = '— Chưa có topic nào —';
          return;
        }
        st.subscriptions.forEach((t) => {
          const item = document.createElement('div');
          item.className = 'sub-item';
          const code = document.createElement('code');
          code.textContent = t;
          const btn = document.createElement('button');
          btn.className = 'btn btn-danger btn-sm';
          btn.textContent = 'Bỏ sub';
          btn.onclick = () => unsubscribeTopic(t);
          item.appendChild(code);
          item.appendChild(btn);
          list.appendChild(item);
        });
      } catch (e) { /* bỏ qua khi chưa kết nối */ }
    }

    async function pollMessages() {
      try {
        const json = await (await fetch(API + '/messages?after=' + lastMessageId)).json();
        if (!json.result) return;
        const { messages, lastId } = json.result;
        if (messages && messages.length) {
          lastMessageId = lastId;
          messages.forEach((m) => {
            addLog(m.topic, m.payload, 'received', m);
            // Khi tab đang ở nền và chưa bật push -> nhờ Service Worker hiện thông báo
            if (document.hidden && !pushEnabled && 'serviceWorker' in navigator && navigator.serviceWorker.controller) {
              navigator.serviceWorker.controller.postMessage({
                type: 'mqtt-message-notification',
                title: 'MQTT · ' + m.topic,
                body: m.payload,
                topic: m.topic,
                url: '/mqtt',
              });
            }
          });
        }
      } catch (e) { /* bỏ qua */ }
    }
async function doConnect() {
      try {
        $('connectBtn').disabled = true;
        $('connectBtn').innerHTML = '&#9696; Connecting...';
        const body = {
          protocol: $('protocol').value,
          host: $('host').value.trim(),
          port: $('port').value.trim(),
          username: $('username').value.trim(),
          password: $('password').value,
          clientId: $('clientId').value.trim(),
          keepalive: $('keepalive').value.trim(),
          topics: $('autoTopics').value.trim(),
        };
        const st = await api('/connect', 'POST', body);
        setStatusBadge(st);
        addLog('Hệ thống', 'Kết nối thành công tới ' + (st.options && st.options.url), 'publish');
        refreshStatus();
      } catch (e) {
        addLog('Hệ thống', 'Kết nối lỗi: ' + e.message, 'error');
      } finally {
        $('connectBtn').disabled = false;
        $('connectBtn').innerHTML = '&#128268; Connect';
      }
    }

    async function doDisconnect() {
      try {
        const st = await api('/disconnect', 'POST', {});
        setStatusBadge(st);
        addLog('Hệ thống', 'Đã ngắt kết nối', 'publish');
        refreshStatus();
      } catch (e) {
        addLog('Hệ thống', 'Ngắt kết nối lỗi: ' + e.message, 'error');
      }
    }

    async function doPublish() {
      const topic = $('pubTopic').value.trim();
      const message = $('pubMessage').value;
      const qos = parseInt($('pubQos').value, 10) || 0;
      const retain = $('pubRetain').checked;
      if (!topic) { addLog('Hệ thống', 'Chưa nhập topic để publish', 'error'); return; }
      try {
        const info = await api('/publish', 'POST', { topic, message, qos, retain });
        addLog(topic, message + ' → đã gửi', 'publish', { qos: info.qos, retain: info.retain });
      } catch (e) {
        addLog(topic, 'Publish lỗi: ' + e.message, 'error');
      }
    }

    async function doSubscribe() {
      const topic = $('subTopic').value.trim();
      const qos = parseInt($('subQos').value, 10) || 0;
      if (!topic) { addLog('Hệ thống', 'Chưa nhập topic để subscribe', 'error'); return; }
      try {
        await api('/subscribe', 'POST', { topic, qos });
        addLog(topic, 'Đã đăng ký subscribe', 'subscribe');
        refreshStatus();
      } catch (e) {
        addLog(topic, 'Subscribe lỗi: ' + e.message, 'error');
      }
    }

    async function unsubscribeTopic(topic) {
      try {
        await api('/unsubscribe', 'POST', { topic });
        addLog(topic, 'Đã hủy subscribe', 'subscribe');
        refreshStatus();
      } catch (e) {
        addLog(topic, 'Unsubscribe lỗi: ' + e.message, 'error');
      }
    }

    async function clearAllLog() {
      $('msgLog').innerHTML = '';
      lastMessageId = 0;
      try { await api('/messages', 'DELETE'); } catch (e) { /* bỏ qua */ }
    }

    function urlBase64ToUint8Array(base64String) {
      const pad = '='.repeat((4 - (base64String.length % 4)) % 4);
      const b64 = (base64String + pad).replace(/-/g, '+').replace(/_/g, '/');
      const bin = atob(b64);
      const out = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }

    function setBgStatus(text, cls) {
      const el = $('bgStatus');
      el.textContent = text;
      el.className = 'help' + (cls ? ' ' + cls : '');
    }

    async function onToggleBackground() {
      if (pushEnabled) { await disableBackground(); return; }
      await enableBackground();
    }

    async function enableBackground() {
      try {
        if (!('Notification' in window)) throw new Error('Trình duyệt không hỗ trợ thông báo (Notification API)');
        if (!('serviceWorker' in navigator)) throw new Error('Trình duyệt không hỗ trợ Service Worker');
        let perm = Notification.permission;
        if (perm !== 'granted') perm = await Notification.requestPermission();
        if (perm !== 'granted') {
          setBgStatus('Bạn đã từ chối nhận thông báo. Cần bật lại trong cài đặt trình duyệt.', 'err');
          return;
        }
        // Đăng ký Service Worker nếu chưa có
        if (!navigator.serviceWorker.controller) {
          await navigator.serviceWorker.register('/mqtt/service-worker.js');
        }
        const reg = await navigator.serviceWorker.ready;
        const keyResp = await fetch('/api/mqtt/push/key');
        const keyJson = await keyResp.json();
        if (!keyJson.result || !keyJson.result.publicKey) throw new Error('Không lấy được VAPID public key');
        let sub = await reg.pushManager.getSubscription();
        if (!sub) {
          sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(keyJson.result.publicKey),
          });
        }
        const filter = $('notiffilter').value.trim();
        const resp = await fetch('/api/mqtt/push/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription: sub, topic: filter }),
        });
        const j = await resp.json();
        if (!resp.ok) throw new Error(j.error || 'Đăng ký push lỗi');
        pushEnabled = true;
        localStorage.setItem('mqtt-bg', '1');
        $('bgBtn').textContent = 'Tắt lắng nghe nền';
        $('bgBtn').className = 'btn btn-danger';
        setBgStatus('Đã bật. Khi có bản tin MQTT, trình duyệt sẽ hiện thông báo ngay cả khi tab ở nền hoặc đã đóng trang.', 'ok');
        addLog('Thông báo', 'Đã bật lắng nghe nền + push notification', 'publish');
      } catch (e) {
        setBgStatus('Lỗi: ' + e.message, 'err');
        addLog('Thông báo', 'Lỗi bật lắng nghe nền: ' + e.message, 'error');
      }
    }

    async function disableBackground() {
      try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        if (sub) {
          try {
            await fetch('/api/mqtt/push/unsubscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ endpoint: sub.endpoint }),
            });
          } catch (e) { /* bỏ qua */ }
          try { await sub.unsubscribe(); } catch (e) { /* bỏ qua */ }
        }
        pushEnabled = false;
        localStorage.removeItem('mqtt-bg');
        $('bgBtn').textContent = 'Bật lắng nghe nền';
        $('bgBtn').className = 'btn btn-accent';
        setBgStatus('Đã tắt');
        addLog('Thông báo', 'Đã tắt lắng nghe nền', 'publish');
      } catch (e) {
        setBgStatus('Lỗi tắt: ' + e.message, 'err');
      }
    }

    async function onFilterChange() {
      if (!pushEnabled) return;
      try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        if (!sub) return;
        const resp = await fetch('/api/mqtt/push/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription: sub, topic: $('notiffilter').value.trim() }),
        });
        if (resp.ok) setBgStatus('Đã cập nhật bộ lọc topic nhận thông báo', 'ok');
      } catch (e) { /* bỏ qua */ }
    }

    async function restoreBackgroundOnLoad() {
      try {
        if (!('Notification' in window)) { localStorage.removeItem('mqtt-bg'); return; }
        if (!('serviceWorker' in navigator)) { localStorage.removeItem('mqtt-bg'); return; }
        await navigator.serviceWorker.register('/mqtt/service-worker.js');
        if (localStorage.getItem('mqtt-bg') !== '1') return;
        await enableBackground();
        if (!pushEnabled) localStorage.removeItem('mqtt-bg');
      } catch (e) { /* bỏ qua khi offline hay chưa cấu hình */ }
    }

    async function importConfig() {
      try {
        const icon = $('importCfgIcon');
        icon.textContent = '&#8635;';
        $('importCfgBtn').disabled = true;
        const resp = await fetch('/api/mqtt/config');
        const j = await resp.json();
        if (!resp.ok || !j.result) throw new Error(j.error || 'Không lấy được cấu hình');
        const c = j.result;
        $('protocol').value = c.protocol;
        $('host').value = c.host;
        $('port').value = c.port;
        $('username').value = c.user;
        $('password').value = c.pass || '';
        $('clientId').value = c.clientId;
        $('keepalive').value = c.keepalive;
        setBgStatus('Đã tải cấu hình MQTT_* từ server (.env)', 'ok');
        addLog('Hệ thống', 'Import cấu hình .env', 'publish');
      } catch (e) {
        setBgStatus('Import lỗi: ' + e.message, 'err');
        addLog('Hệ thống', 'Import cấu hình lỗi: ' + e.message, 'error');
      } finally {
        const icon = $('importCfgIcon');
        icon.textContent = '&#128190;';
        $('importCfgBtn').disabled = false;
      }
    }

    async function loadConfigOnStart() {
      // tự load thông参数 MQTT_* ngay tại page để đồng bộ tản giá với server
      try {
        const resp = await fetch('/api/mqtt/config');
        const j = await resp.json();
        if (!resp.ok || !j.result) return;
        const c = j.result;
        $('protocol').value = c.protocol;
        $('host').value = c.host;
        $('port').value = c.port;
        $('username').value = c.user;
        $('password').value = c.pass || '';
        $('clientId').value = c.clientId;
        $('keepalive').value = c.keepalive;
      } catch (e) { /* bỏ qua khi offline hay API chưa ready */ }
    }

    window.addEventListener('DOMContentLoaded', () => {
      $('connectBtn').onclick = doConnect;
      $('disconnectBtn').onclick = doDisconnect;
      $('publishBtn').onclick = doPublish;
      $('subBtn').onclick = doSubscribe;
      $('clearLogBtn').onclick = clearAllLog;
      $('bgBtn').onclick = onToggleBackground;
      $('importCfgBtn').onclick = importConfig;
      $('notiffilter').addEventListener('change', onFilterChange);
      $('pubTopic').addEventListener('keydown', (e) => { if (e.key === 'Enter') doPublish(); });
      $('subTopic').addEventListener('keydown', (e) => { if (e.key === 'Enter') doSubscribe(); });
      if (!('Notification' in window)) setBgStatus('Trình duyệt không hỗ trợ thông báo', 'err');
      refreshStatus();
      loadConfigOnStart();
      restoreBackgroundOnLoad();
      setInterval(() => { refreshStatus(); pollMessages(); }, 1000);
    });
  </script>
</body>
</html>