# Application
APP_PORT=3000
APP_HOST=127.0.0.1

# Environment
NODE_ENV=development
NODE_HTTPS=server_edu

# Database
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=hust_tech
DB_PORT=3306
# MongoDB used by /api/mongodb.  Never expose this URI to clients.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=iot
# MONGODB_REPORT_TIMEZONE=Asia/Ho_Chi_Minh
APP_LINK_STORGATE=http://localhost:3000
# Mysql socket path /path/to/mysql.sock
#SOCKET_PATH=<YOUR_SOCKET_PATH>

# Log
LOG_DIR=logs
#LOG_LEVEL='debug'

TOKEN_SECRET_KEY=secretkeyforjsonwebtoken

ASSETSDIR='public'

ID_S3_INFO=
SECRET_S3_INFO=
BUCKET_NAME_S3_INFO=techhust
FILE_S3_RETURN=test
LINK_FLODER_PUBLIC=F:\ManagerProject\hust-tech1\WebManage\

# GMAIL INFO
MAIL_CLIENT_INFO=
MAIL_PASS_INFO=
KEY_ZALO_TOCKEN=NHAPAPIKEYCUABAN
KEY_ZALO_ID=NHAPAPIIDCUABAN

#FacebookInfo
FACE_BOOK_ACAO = 
FACE_BOOK_PASSS = 



# MQTT Broker - cau hinh mac dinh cho trang dieu khien MQTT (/mqtt)
# MqttBroker1885.js chi nhan MQTTS + mTLS voi chung chi ECDSA P-256.
MQTT_PROTOCOL=mqtts
MQTT_HOST=localhost
MQTT_PORT=1885
MQTT_USER=
MQTT_PASS=
# clientId phai trung CN chung chi va fingerprint trong mqtt_device_certs.json
MQTT_CLIENT_ID=web_manager
MQTT_KEEPALIVE=60
# Thu muc chung chi (dung chung voi saveCertificateMqtt): ca.crt, ca.key,
# <MQTT_CLIENT_ID>.crt, <MQTT_CLIENT_ID>.key
MQTT_CERTS=../mqttBroker/certs
# Tuy chon: duong dan rieng thay cho MQTT_CERTS
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# false khi broker tat enableAttack (chong replay)
MQTT_REPLAY_PROTECTION=true
# Khi broker bat enableMessageAuthentication: key trong mqtt_message_auth.json
MQTT_HMAC_SECRET=
MQTT_HMAC_KEY_ID=web_manager

# Broker o server khac (saveCertificateMqtt / getCertificateMqtt).
# Trong: broker cung server, ghi thang cac file JSON trong MQTT_BROKER_DIR.
# Co gia tri: goi mqttBroker/BrokerAdminApi.js qua HTTPS + mTLS
# (dung MQTT_CA_CERT / MQTT_CLIENT_CERT / MQTT_CLIENT_KEY o tren).
MQTT_BROKER_ADMIN_URL=
# Ten host co trong subjectAltName cua server.crt (khi URL dung IP/ten khac)
MQTT_BROKER_ADMIN_SERVERNAME=
MQTT_BROKER_ADMIN_TIMEOUT_MS=5000
# Chu ky gui lai cac cau hinh broker chua nhan (0 = tat)
MQTT_BROKER_SYNC_INTERVAL_MS=30000
# Thu muc CA (ca.crt + ca.key) va chung chi thiet bi tren server web_manager.
# Mac dinh = MQTT_CERTS
MQTT_PKI_DIR=
# Chi dung khi MQTT_BROKER_ADMIN_URL trong. Mac dinh = thu muc cha cua MQTT_PKI_DIR
MQTT_BROKER_DIR=

# Gia han chung chi thiet bi (certRenewal.js, lenh com 16). Giu nguyen khoa
# rieng, chi gui chung chi moi xuong thiet bi. Chay "npx knex migrate:latest".
# Thoi han chung chi cap moi / gia han (ngay)
MQTT_CERT_VALID_DAYS=3650
# Bat dau gia han truoc khi het han bao nhieu ngay
MQTT_CERT_RENEW_BEFORE_DAYS=180
# Chu ky kiem tra (ms, 0 = tat) va chu ky gui lai com 16 khi chua co tra loi
MQTT_CERT_RENEW_CHECK_MS=3600000
MQTT_CERT_RENEW_RESEND_MS=21600000

# Gia han CA / chung chi broker / chung chi web_manager (pkiRenewal.js, com 17).
# Giu nguyen khoa; can OpenSSL >= 3.0 tren server web_manager.
MQTT_CA_VALID_DAYS=7300
MQTT_CA_RENEW_BEFORE_DAYS=365
MQTT_SERVER_CERT_VALID_DAYS=3650
MQTT_SERVER_CERT_RENEW_BEFORE_DAYS=180
MQTT_SERVICE_CERT_RENEW_BEFORE_DAYS=180
MQTT_PKI_RENEW_CHECK_MS=21600000

# Web Push (thong bao nen) - nut Bat lang nghe nen tren trang /mqtt
# Neu khong khai VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY server tu sinh va luu tai server/config/vapid.keys.json
VAPID_SUBJECT=mailto:admin@localhost
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
