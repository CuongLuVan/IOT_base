# =============================================================================
# mqttBroker/.env.sample -> copy thanh mqttBroker/.env tren SERVER BROKER
# Dung cho BrokerAdminApi.js (npm run admin). Bien moi truong cua he thong
# duoc uu tien hon file nay. Duong dan tuong doi tinh tu thu muc mqttBroker.
# =============================================================================

# Dia chi lang nghe. Nen dung IP mang noi bo va chi mo firewall cong nay cho
# IP cua server web_manager.
BROKER_ADMIN_HOST=0.0.0.0
BROKER_ADMIN_PORT=8885

# CN cua client certificate duoc phep goi API (cach nhau boi dau phay).
# Chung chi phai do certs/ca.crt ky. Cac clientId nay cung khong the bi
# ghi de / thu hoi qua API.
BROKER_ADMIN_ALLOWED_CN=web_manager

# Chung chi HTTPS cua API (ECDSA P-256). Mac dinh dung chung chi cua broker.
# subjectAltName phai chua host/IP ma web_manager dat trong
# MQTT_BROKER_ADMIN_URL (hoac MQTT_BROKER_ADMIN_SERVERNAME).
BROKER_ADMIN_CERT=certs/server.crt
BROKER_ADMIN_KEY=certs/server.key

# Thu muc chua mqtt_acl.json, mqtt_client_ids.json, mqtt_device_certs.json,
# mqtt_message_auth.json, mqtt_users.json (cung thu muc broker dang doc).
MQTT_BROKER_DIR=.

# Thu muc chua ca.crt (de xac thuc web_manager va chung chi thiet bi).
# KHONG can ca.key tren server broker: ca.key nam o server web_manager.
MQTT_CERTS=certs
